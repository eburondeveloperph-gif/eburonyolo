// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: enrollments
// Document ID: auto-generated
// Fields:
//   - name: string (required, 1-100 chars) - The subject's name
//   - photo: string (required, base64 data) - The subject's face photo
//   - timestamp: number (required) - Creation time
//   - authorUid: string (required) - The operator's UID
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "eburondeveloperph@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidEnrollment(data) {
      return hasRequiredFields(['name', 'photo', 'timestamp', 'authorUid']) &&
             hasOnlyAllowedFields(['name', 'photo', 'timestamp', 'authorUid']) &&
             validStringLength('name', 1, 100) &&
             data.photo is string && data.photo.size() < 1048576 && // Max 1MB
             data.timestamp is number &&
             data.authorUid == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /enrollments/{enrollmentId} {
      // Only authenticated operators can read enrollments
      allow read: if isAuthenticated();
      
      // Only authenticated operators can create enrollments, and they must be valid
      allow create: if isAuthenticated() && isValidEnrollment(request.resource.data);
      
      // Only admins can delete enrollments
      allow delete: if isAdmin();
      
      // Updates are not allowed for biometric integrity
      allow update: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role == 'operator';
      allow update: if isAdmin();
    }
  }
}
